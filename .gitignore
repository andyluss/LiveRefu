# 系统文件
.DS_Store

# Python 缓存
__pycache__/
*.pyc
*.pyo

# Godot 生成缓存（工程内已在 game/.gitignore 处理）
.godot/

# Godot 用户数据目录（game/run.sh 把 HOME 指到这里，避免写 ~/Library）
.godot-home/

# 独立子仓库（各自有自己的 .git 与远程，见 indie/README.md）
# 忽略而非提交，避免父仓库把它误存成 gitlink（嵌入式仓库）
indie/dsh-pet-refu/
indie/live-rpg/
indie/live-calculator/

# 包管理器临时目录（沙箱下 bun 会用到）
.tmp/

# NodeBB OIDC 插件的 vendor 目录（由 fetch-plugin.sh 生成，不入库）
projects/livefab/deploy/nodebb/vendor/
