#!/usr/bin/env bash
#
# git pre-commit 钩子：拦截提交问题（全部用 TS 脚本跑，node --experimental-strip-types，见
#   lab/formal-system/tech/rules/T01-default-ts-scripts.md）。
#   1. 失效内部相对链接(检查暂存的 *.md, 交 tools/check_links.ts)。
#   2. 数据表不符合 schema(检查暂存涉及的 data/tables 变更, 交 tools/check_data.ts)。
#   3. 元规则结构/演进状态/STRUCTURE.md（暂存涉及 lab/formal-system 时, 交 meta-rules/*.ts）。
#   4. 规则目录 rules/ 的元规则结构 + 规则演进状态（暂存涉及 rules/ 时, 交 rules/meta/*.ts）。
#   5. Refu Game 001 难度模型：自检 + 章节带位 + 远征节点带位（暂存涉及 refu-game-001 或模拟脚本时,
#      交 tools/sim_refu_game_001.ts；数值一改就会触发）。
#   6. 变更日志格式：版本头/时间单调/标准类目，以及**版本号与 git tag 是否对得上**
#      （暂存涉及根 CHANGELOG.md 或 projects/livefab/CHANGELOG.md 时，交 tools/check_changelog.ts）。
#   6. 变更日志格式：版本头/时间单调/标准类目，以及**版本号与 git tag 是否对得上**
#      （暂存涉及根 CHANGELOG.md 或 projects/livefab/CHANGELOG.md 时，交 tools/check_changelog.ts）。
#
# 启用方式：git config core.hooksPath tools/hooks（仓库已配置）。
# 临时跳过：git commit --no-verify。
# 只校验暂存相关文件，不扫全工作区，避免误拦与本次改动无关的既有问题。

set -euo pipefail

GIT_ROOT="$(git rev-parse --show-toplevel)"

# 用 node 的 type-stripping 直接跑 TS（本仓库脚本 node/deno/bun 兼容）。
run_ts() { node --experimental-strip-types "$1" "${@:2}"; }

# ---- 1) 暂存的 Markdown 相对链接校验 ----
LINK_SCRIPT="$GIT_ROOT/tools/check_links.ts"
if [ ! -f "$LINK_SCRIPT" ]; then
  echo "[pre-commit:check-links] 未找到 ${LINK_SCRIPT}，跳过链接校验。" >&2
else
  STAGED=()
  # ★ `ACMR` 的 R 是必需的：**重命名也是内容变更**（对链接而言尤其如此——搬家会改变相对深度）。
  #   原先只取 ACM 时，一次 327 个文件的搬家只有 17 个 Markdown 进入校验，
  #   且**确实漏掉过一条错链**（被全量校验抓到）。`--name-only` 对重命名给出的是**新路径**，
  #   那正是要校验的对象。
  while IFS= read -r -d '' f; do STAGED+=("$f"); done \
    < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md')
  if [ "${#STAGED[@]}" -gt 0 ]; then
    echo "[pre-commit:check-links] 校验 ${#STAGED[@]} 个暂存 Markdown 的相对链接..." >&2
    if run_ts "$LINK_SCRIPT" --files "${STAGED[@]}" >&2; then
      echo "[pre-commit:check-links] 通过。" >&2
    else
      echo "[pre-commit:check-links] 存在失效链接，已拦截提交。" >&2
      exit 1
    fi
  fi
fi

# ---- 2) 数据表 schema 校验 ----
DATA_SCRIPT="$GIT_ROOT/tools/check_data.ts"
if [ ! -f "$DATA_SCRIPT" ]; then
  echo "[pre-commit:check-data] 未找到 ${DATA_SCRIPT}，跳过数据校验。" >&2
exit 0
fi
# 只要本次暂存涉及 data/ 下任何表(json/schema), 就跑全量数据校验(数据表彼此多依赖)
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^projects/tomorrows-channel/data/(tables|schema)/'; then
  echo "[pre-commit:check-data] 暂存涉及数据表变更，校验 schema 契约..." >&2
  if run_ts "$DATA_SCRIPT" >&2; then
    echo "[pre-commit:check-data] 通过。" >&2
  else
    echo "[pre-commit:check-data] 数据表不符合 schema，已拦截提交。" >&2
    echo "  请检查 data/schema 与 data/tables 一致性(必填/type/enum/数值范围)。" >&2
    exit 1
  fi
fi

# ---- 3) 元规则 M1+M2 结构校验(仅当暂存涉及 lab/formal-system) ----
META_SCRIPT="$GIT_ROOT/lab/formal-system/concerns/meta-rules/tools/meta_rules_check.ts"
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^lab/formal-system/'; then
  if [ ! -f "$META_SCRIPT" ]; then
    echo "[pre-commit:meta-rules] 未找到 ${META_SCRIPT}，跳过元规则校验。" >&2
  else
    echo "[pre-commit:meta-rules] 暂存涉及 lab/formal-system，校验元规则 M1+M2 结构..." >&2
    if run_ts "$META_SCRIPT" >&2; then
      echo "[pre-commit:meta-rules] 通过。" >&2
    else
      echo "[pre-commit:meta-rules] 文件组织/命名不符合元规则(M1 关注点优先/类型其次 + M2 命名词表)，已拦截提交。" >&2
      echo "  参考: lab/formal-system/concerns/meta-rules/M1-file-organization.md / M2-naming-vocabulary.md" >&2
      exit 1
    fi
    # 元规则演进状态检查（M3 状态机）
    EVOL_SCRIPT="$GIT_ROOT/lab/formal-system/concerns/meta-rules/evolution/rule_evolution_check.ts"
    if [ -f "$EVOL_SCRIPT" ]; then
      echo "[pre-commit:meta-rules:evolution] 校验元规则演进状态(多状态/子状态/迁移)..." >&2
      if run_ts "$EVOL_SCRIPT" >&2; then
        echo "[pre-commit:meta-rules:evolution] 通过。" >&2
      else
        echo "[pre-commit:meta-rules:evolution] 某条元规则的演进状态/迁移非法，已拦截提交。" >&2
        echo "  参考: lab/formal-system/concerns/meta-rules/M3-rule-evolution.md" >&2
        exit 1
      fi
    fi
    # 每个目录 STRUCTURE.md 检测（M4 目录说明与统一索引）
    STRUCT_SCRIPT="$GIT_ROOT/lab/formal-system/concerns/meta-rules/tools/structure_check.ts"
    if [ -f "$STRUCT_SCRIPT" ]; then
      echo "[pre-commit:meta-rules:structure] 校验目录 STRUCTURE.md(M4)..." >&2
      if run_ts "$STRUCT_SCRIPT" >&2; then
        echo "[pre-commit:meta-rules:structure] 通过。" >&2
      else
        echo "[pre-commit:meta-rules:structure] 有目录缺/不合格 STRUCTURE.md，已拦截提交。" >&2
        echo "  参考: lab/formal-system/concerns/meta-rules/tools/structure_gen.ts" >&2
        exit 1
      fi
    fi
  fi
fi

# ---- 4) 规则目录 rules/ 的元规则结构(M1+M2) + 规则演进状态(M3, 覆盖 M 与 R) ----
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^rules/'; then
  RULES_META_SCRIPT="$GIT_ROOT/rules/meta/tools/meta_rules_check.ts"
  RULES_EVOL_SCRIPT="$GIT_ROOT/rules/meta/evolution/rule_evolution_check.ts"
  if [ -f "$RULES_META_SCRIPT" ]; then
    echo "[pre-commit:rules-meta] 暂存涉及 rules/，校验元规则 M1+M2 结构..." >&2
    if run_ts "$RULES_META_SCRIPT" >&2; then
      echo "[pre-commit:rules-meta] 通过。" >&2
    else
      echo "[pre-commit:rules-meta] rules/ 文件组织/命名不符合元规则(M1 关注点优先/类型其次 + M2 命名词表)，已拦截提交。" >&2
      echo "  参考: rules/meta/M1-file-organization.md / M2-naming-vocabulary.md" >&2
      exit 1
    fi
  else
    echo "[pre-commit:rules-meta] 未找到 ${RULES_META_SCRIPT}，跳过。" >&2
  fi
  if [ -f "$RULES_EVOL_SCRIPT" ]; then
    echo "[pre-commit:rules-meta:evolution] 校验规则演进状态(M3，覆盖元规则 M 与具体规则 R)..." >&2
    if run_ts "$RULES_EVOL_SCRIPT" >&2; then
      echo "[pre-commit:rules-meta:evolution] 通过。" >&2
    else
      echo "[pre-commit:rules-meta:evolution] 某条规则(M/R)的演进状态/迁移非法，已拦截提交。" >&2
      echo "  参考: rules/meta/M3-rule-evolution.md" >&2
      exit 1
    fi
  else
    echo "[pre-commit:rules-meta:evolution] 未找到 ${RULES_EVOL_SCRIPT}，跳过。" >&2
  fi
fi

# ---- 5) Refu Game 001 难度模型校验（暂存涉及该卷或模拟脚本时）----
SIM_SCRIPT="$GIT_ROOT/tools/sim_refu_game_001.ts"
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(doc/refu-game-001/|tools/sim_refu_game_001\.ts)'; then
  if [ ! -f "$SIM_SCRIPT" ]; then
    echo "[pre-commit:refu-sim] 未找到 ${SIM_SCRIPT}，跳过难度模型校验。" >&2
  else
    echo "[pre-commit:refu-sim] 暂存涉及 refu-game-001，校验难度模型（自检/章节带位/远征节点）..." >&2
    if run_ts "$SIM_SCRIPT" --selftest >&2 \
      && run_ts "$SIM_SCRIPT" --verify-bands --n 5000 >&2 \
      && run_ts "$SIM_SCRIPT" --verify-rogue --n 5000 >&2 \
      && run_ts "$SIM_SCRIPT" --verify-faction >&2 \
      && run_ts "$SIM_SCRIPT" --verify-seed >&2 \
      && run_ts "$SIM_SCRIPT" --verify-anti-air >&2 \
      && run_ts "$SIM_SCRIPT" --verify-air-matrix >&2 \
      && run_ts "$SIM_SCRIPT" --verify-air-mix >&2 \
      && run_ts "$SIM_SCRIPT" --verify-pmod >&2; then
      echo "[pre-commit:refu-sim] 通过。" >&2
    else
      echo "[pre-commit:refu-sim] 难度模型自检或带位校验失败，已拦截提交。" >&2
      echo "  复核: node --experimental-strip-types tools/sim_refu_game_001.ts --verify-bands --n 20000" >&2
      exit 1
    fi
  fi
fi

# ---- 5.5) 时间戳文件名（R06 时间与时间戳约定）----
# 只在暂存涉及**时事件目录**时跑（`discussions/`、`plans/`）——它们混着非时间戳文件，
# 闸门只守"看起来像时间戳的文件必须格式正确"，并核对"文件名时间不得晚于首次提交时间"。
# 这条闸门的存在理由很具体：曾经把讨论记录写成 `2026-09-30_主题.md`（旧形态，无时分），
# 而当时**没有任何检查会发现它**。
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '(^|/)(discussions|plans)/'; then
  TIME_SCRIPT="$GIT_ROOT/tools/check_time_naming.ts"
  if [ -f "$TIME_SCRIPT" ]; then
    echo "[pre-commit:time-naming] 校验时间戳文件名（R06）..." >&2
    if run_ts "$TIME_SCRIPT" >&2; then
      echo "[pre-commit:time-naming] 通过。" >&2
    else
      echo "[pre-commit:time-naming] 时间戳文件名不合规，已拦截提交。" >&2
      echo "  参考: rules/R06-time.md（格式 YYYYMMDD-HHMM-关键词；时间取自首次提交时间）" >&2
      exit 1
    fi
  else
    echo "[pre-commit:time-naming] 未找到 ${TIME_SCRIPT}，跳过。" >&2
  fi
fi

# ---- 5.8) 元规则 M1+M2 的**工作区覆盖**（关注点级别，不只 rules/）----
# 为什么要有这一步：`rules/meta/tools/meta_rules_check.ts` 一次只查**一个关注点**，
# 而此前只有 rules/ 与 lab/ 写了配置——于是"在项目里另立一套命名"不会被发现
# （2026-10-08 讨论记录命名与 M2 冲突，就是这么漏过去的）。
# 这里跑的是**清单驱动**的覆盖检查：只有 block 的关注点会拦截，report 的关注点
# 只记欠账（见 rules/meta/tools/workspace-scope.json，缺口写在明处）。
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(rules/|projects/)'; then
  SCOPE_SCRIPT="$GIT_ROOT/rules/meta/tools/meta_rules_scope.ts"
  if [ -f "$SCOPE_SCRIPT" ]; then
    echo "[pre-commit:meta-scope] 校验纳入闸门的关注点（M1+M2 覆盖清单）..." >&2
    if run_ts "$SCOPE_SCRIPT" --block-only >&2; then
      echo "[pre-commit:meta-scope] 通过。" >&2
    else
      echo "[pre-commit:meta-scope] 纳入闸门的关注点存在 M1/M2 违规，已拦截提交。" >&2
      echo "  参考: rules/meta/M1-file-organization.md / M2-naming-vocabulary.md" >&2
      echo "  清单: rules/meta/tools/workspace-scope.json" >&2
      exit 1
    fi
  else
    echo "[pre-commit:meta-scope] 未找到 ${SCOPE_SCRIPT}，跳过。" >&2
  fi
fi

# ---- 6) 变更日志格式与版本-标签一致性（通用：根 + 各项目）----
# 规格见 tech/changelog-convention.md 与 projects/livefab/docs/06_变更日志方案选择.md（方案甲）。
# ★ 由 LiveFab 专用提升为**通用**：本工作区有多个 CHANGELOG，规格相同、
#   只是路径与 tag 前缀不同（根用 workspace-v，LiveFab 用 livefab-v）。
CHANGELOG_SCRIPT="$GIT_ROOT/tools/check_changelog.ts"
check_changelog() {  # $1=路径 $2=tag 前缀 $3=显示名 $4=额外参数（可选，如 --assert-workspace-level）
  if [ ! -f "$CHANGELOG_SCRIPT" ]; then
    echo "[pre-commit:changelog] 未找到 ${CHANGELOG_SCRIPT}，跳过 ${3}。" >&2
    return 0
  fi
  echo "[pre-commit:changelog] 校验 ${3} 的格式与版本-标签一致性..." >&2
  if run_ts "$CHANGELOG_SCRIPT" --file "$1" --tag-prefix "$2" ${4:-} >&2; then
    echo "[pre-commit:changelog] ${3} 通过。" >&2
  else
    echo "[pre-commit:changelog] ${3} 不合规（格式，或版本头时间与 git tag 对不上），已拦截提交。" >&2
    exit 1
  fi
}
STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACMR)"
# ★ 覆盖**所有被跟踪的 CHANGELOG**（动态发现，新项目自动纳入）。
#   ⚠️ `indie/*` 是**独立仓库**、被根 .gitignore 排除，不会出现在这里 ——
#      它们的日志要用各自仓库的 git 历史才能定版本时间，尚未纳入统一格式。
STAGED_LOGS="$(printf '%s\n' "$STAGED_ALL" | grep -E '(^|/)CHANGELOG\.md$' || true)"
# ① 根日志：额外要求"不含子项目专属条目"
if printf '%s\n' "$STAGED_LOGS" | grep -q '^CHANGELOG\.md$'; then
  check_changelog CHANGELOG.md workspace-v "工作区根日志" --assert-workspace-level
fi
# ② 其余：按文件给 tag 前缀，从而启用**版本-标签一致性**校验
#    （那条是最值钱的一条：它把日志与 git 钉在一起，谁事后改时间都会被发现）
for lg in $STAGED_LOGS; do
  [ "$lg" = "CHANGELOG.md" ] && continue
  case "$lg" in
    projects/livefab/CHANGELOG.md)          prefix="livefab-v" ;;
    projects/website/CHANGELOG.md)          prefix="website-v" ;;
    lab/formal-system/CHANGELOG.md)         prefix="formal-system-v" ;;
    projects/mainline/future-debris/CHANGELOG.md) prefix="future-debris-v" ;;
    projects/mainline/CHANGELOG.md)         prefix="mainline-v" ;;
    projects/refu-game-001/CHANGELOG.md)    prefix="refu-game-001-v" ;;
    projects/tomorrows-channel/CHANGELOG.md) prefix="tomorrows-channel-v" ;;
    *) prefix="" ;;
  esac
  check_changelog "$lg" "$prefix" "$lg"
done

exit 0
