  "type_vocab": ["docs","data","game","src","code","test","tests","plans","art","assets","references","tools","scripts","deploy","public","scenes","notes","specs","methods"],
  "code_types": ["game","src","code","tools","scripts","deploy","public","scenes"],
  "empty_ok_types": [],
  "doc_naming": { "default": ["^\\d+_", "^\\d+-", "^[a-zA-Z0-9_.-]+$"] },
  "skip_dirs": ["__pycache__","target",".git","node_modules",".godot",".build",".shots",".next",".nuxt","dist","vendor"],
  "skip_prefixes": [".","_"],
  "sub_concerns": [],
  "sub_concerns_dir": null,
  "sub_configs": {}
