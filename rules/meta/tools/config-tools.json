  "doc_naming": { "default": ["^[a-z0-9]+([._-][a-z0-9]+)*\\.(ts|py|sh|json)$", "^README$"] },
  "skip_dirs": [".git", "node_modules", "__pycache__"],
  "skip_prefixes": [".", "_"],
  "sub_concerns": [],
  "sub_concerns_dir": null,
  "sub_configs": {}
}
