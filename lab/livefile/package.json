{
  "name": "livefile",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "LiveFile — local-first personal archive workbench",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/cli.ts serve",
    "start": "node src/cli.ts serve",
