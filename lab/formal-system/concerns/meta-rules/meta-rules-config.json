{
  "_comment": "元规则 M1(文件组织,含递归子关注点/统一目录) + M2(命名/类型词表) 的可运行判定配置。默认对象 = lab/formal-system(重组后: 子关注点统一目录 concerns/ + 类型目录 methods/specs)。对应规则见 M1-file-organization.md / M2-naming-vocabulary.md。",
  "concern": "lab/formal-system",
  "root": ".",
  "root_docs": ["README.md", "CHANGELOG.md", "EXPERIMENT.md"],
  "type_vocab": ["methods", "specs", "tech"],
  "code_types": [],
  "empty_ok_types": ["methods", "specs"],
  "doc_naming": {
    "default": ["^\\d{2}_", "^\\d{8}(-\\d{4})?-", "^[a-z][a-z0-9_-]*$"],
    "tech": ["^README$", "^[a-z][a-z0-9_-]*$"]
  },
  "skip_dirs": ["__pycache__", "target", ".git", "node_modules"],
  "skip_prefixes": [".", "_"],
  "sub_concerns": [],
  "sub_concerns_dir": "concerns",
  "sub_configs": {
    "data-validator": { "code": true, "root_docs": ["README.md"] },
    "visual-fallback": {
      "root_docs": ["README.md"],
      "type_vocab": ["viz"],
      "code_types": ["tools"],
      "empty_ok_types": [],
      "doc_naming": { "default": ["^[a-z][a-z0-9_-]*\\.(json|html)$", "^README$"] },
      "skip_dirs": ["__pycache__", "target", ".git", "node_modules"],
      "skip_prefixes": [".", "_"],
      "sub_concerns": ["evolution-history"],
      "sub_configs": {
        "evolution-history": {
          "root_docs": ["README.md"],
          "type_vocab": ["viz"],
          "code_types": ["tools"],
          "empty_ok_types": [],
          "doc_naming": {
            "default": ["^[a-z][a-z0-9_-]*\\.md$", "^README$"],
            "viz": ["^[a-z][a-z0-9_-]*\\.(html|json)$", "^README$"]
          },
          "skip_dirs": ["__pycache__", "target", ".git", "node_modules"],
          "skip_prefixes": [".", "_"],
          "sub_concerns": []
        }
      }
    },
    "meta-rules": {
      "root_docs": ["README.md"],
      "type_vocab": [],
      "code_types": ["tools"],
      "empty_ok_types": [],
      "doc_naming": { "default": ["^M\\d+-", "^meta-rules-config\\.json$", "^README$"] },
      "skip_dirs": ["__pycache__", "target", ".git", "node_modules"],
      "skip_prefixes": [".", "_"],
      "sub_concerns": ["evolution"],
      "sub_configs": {
        "evolution": { "code": true, "root_docs": ["README.md"] }
      }
    }
  }
}
