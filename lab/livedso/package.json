{
  "name": "livedso",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LiveDSO — local-first design system operations workbench",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "livedso": "./src/cli.ts"
  },
  "scripts": {
    "dev": "node --watch src/cli.ts serve",
    "start": "node src/cli.ts serve",
    "check": "node src/cli.ts check",
    "build": "node src/cli.ts build",
    "report": "node src/cli.ts report",
    "test": "node --test test/core.test.ts"
  }
}
