; Engine configuration file.
; Refu Game 001 · 卡片式塔防（M1 垂直切片：铁砧联邦 12 卡 + 峡谷哨站 6 波）
; 竖屏手机优先（doc/refu-game-001/07_移动端与界面.md）；渲染器与工作区主线一致用 GL Compatibility。

config_version=5

[application]

config/name="Refu Game 001"
config/description="卡片式塔防：三主族对抗，规则层全要素卡化。M1 垂直切片。"
config/version="0.1.0"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
AppState="*res://scripts/autoload/app_state.gd"
UiFont="*res://scripts/autoload/ui_font.gd"

[display]

; 设计分辨率＝竖屏 720×1280（07 号文档：战场约 60%、卡牌区约 40%）
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[input_devices]

pointing/emulate_touch_from_mouse=true
