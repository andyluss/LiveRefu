# LiveFab · Caddy 反代配置（M0）
#
# 这是唯一的对外入口。三条设计约束：
#   1. **只有 caddy 发布端口**；其余服务只在 internal 网络上（见 compose.yml）。
#   2. **前置鉴权分层**（docs/01 §5.3）：
#        · 公开区（门户首页、博客、公开路线图）→ **不挡**，任何人可看；
#        · 个人区（/account/**）→ 挡，进入后是"我自己的东西"；
#        · 内部区（/admin/**、未来的看板/文档/密钥）→ 必须在**网关**就拦住。
#   3. Authelia 的 forward_auth **只对需要保护的路径生效**，不要整站一条规则——
#      整站挡登录会把公开内容也挡掉，那正是 §5.3 明确不允许的。

{
	# ACME 通知邮箱
	email {$LIVEFAB_ACME_EMAIL}
	# ★ 本地/内网验证时设 LIVEFAB_LOCAL_CERTS=local_certs，改用 Caddy 内网 CA 签发证书。
	#   为什么需要：真启动才发现，用 .test 之类的假域名时 ACME 会失败
	#   （Let's Encrypt 报 "contact email has invalid domain"），
	#   于是一个证书都签不出来，HTTPS 全不通。
	#   生产环境把该项留空即走正常 ACME。
	{$LIVEFAB_LOCAL_CERTS}
}

# ══ 内部区：必须登录，且在网关就被拦住 ══════════════════════════════
# M0 还没有内部件，但先把"内部区必须在网关拦"这条**结构化地留在这里**，
# 避免 M1 加看板/文档时忘了它。
{$LIVEFAB_PORTAL_DOMAIN} {
	handle /admin/* {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://{$LIVEFAB_AUTH_DOMAIN}
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		# 反代到真门户；forward_auth 已把身份注入为请求头
		reverse_proxy portal:4321
	}

	# 个人区：挡登录
	handle /account/* {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://{$LIVEFAB_AUTH_DOMAIN}
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy portal:4321
	}

	# ★ 公开区：**不经过 forward_auth**——这是分层的关键
	handle {
		reverse_proxy portal:4321
	}
}

# ══ 鉴权门户：Authelia 自己的界面 ═══════════════════════════════════
{$LIVEFAB_AUTH_DOMAIN} {
	reverse_proxy authelia:9091
}

# ══ 前台件：Ghost ═══════════════════════════════════════════════════
# ★ 只挡 /ghost/（后台），**不挡公开站**——整站挡会违反 docs/01 §5.3
#   （公开内容不得被登录墙挡住），而 Ghost 的公开站就在同一个域上。
#
# ⚠️ 这是**额外一道门**：Ghost 不支持 OIDC（research §九），
#   过了网关仍要输 Ghost 自己的账号密码。两层是否冲突见 M1 实测。
{$LIVEFAB_DOMAIN} {
	# ★ 例外：Ghost 的 **Content API 必须公开**，不能一起挡。
	#
	#   为什么：Content API（`/ghost/api/content/`）是 Ghost 作为**无头 CMS** 的
	#   对外读接口——[L5c](docs/00_决策总表.md) 选的 Astro 前端就靠它**在构建期取内容**。
	#   一刀切挡 `/ghost/*` 会把这个接口一起挡掉，等于**打断 L5c 的整合**。
	#   它是只读的、只暴露已发布内容，本就设计为公开。
	#
	#   ⚠️ Caddy 的 handle 是**互斥且按顺序匹配**的，所以这条必须放在前面。
	handle /ghost/api/content/* {
		reverse_proxy ghost:2368
	}

	# 后台（含 Admin API）：网关保护 + 限定组
	handle /ghost/* {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://{$LIVEFAB_AUTH_DOMAIN}
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy ghost:2368
	}

	# 公开站：不经过 forward_auth
	handle {
		reverse_proxy ghost:2368
	}
}

# ══ 论坛：NodeBB（L6 已定，2026-10-03）══════════════════════════════
# NodeBB 默认端口 4567。WebSocket 由 Caddy 自动处理（reverse_proxy 默认支持 Upgrade）。
# ⚠️ NodeBB 的 OIDC 靠第三方插件（nodebb-plugin-fusionauth-oidc），
#    M0 先用它自己的账号；接入 Authelia 的可行性**待 M1 实测**（见 docs/research §8.3）。
{$LIVEFAB_FORUM_DOMAIN} {
	reverse_proxy nodebb:4567
}
