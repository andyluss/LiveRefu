# LiveFab · 环境变量模板（M0）
#
#   cp .env.example .env   然后填写下面各项
#
# ⚠️ .env 里有明文密钥，**不要提交**（deploy/.gitignore 已忽略）。
#    本文件只放"变量名 + 说明"，不放任何真实值。

# ── 域名 ─────────────────────────────────────────────────────────────
# ★ 关键设计：**各件放在同一个父域的子域下**，Authelia 的会话 cookie 挂在**父域**上。
#
#   为什么必须这样（真实 Authelia 报错逼出来的）：
#     Authelia 要求 `authelia_url` 与 cookie 的 domain **共享 cookie 作用域**。
#     早先 Ghost 在 m0.localhost、鉴权门户在 auth.app.localhost —— 不同源，直接报错：
#       session: domain config #2: option 'authelia_url' does not share a cookie
#       scope with domain 'm0.localhost'
#     改成共享父域后：**一个 cookie 覆盖所有件，也只需要一个鉴权门户**。
#     生产上就是 livefab.com + app./auth./m0./forum. 这种结构。
#
#   本地开发用 *.livefab.localhost：操作系统/浏览器把它解析到 127.0.0.1，
#   不经过 DNS，因此**不受网络代理影响**（.test 域名会被代理解析成 fake-IP）。
LIVEFAB_COOKIE_DOMAIN=livefab.localhost
LIVEFAB_PORTAL_DOMAIN=app.livefab.localhost
LIVEFAB_AUTH_DOMAIN=auth.livefab.localhost
LIVEFAB_DOMAIN=m0.livefab.localhost
LIVEFAB_FORUM_DOMAIN=forum.livefab.localhost

# ACME 证书通知邮箱
LIVEFAB_ACME_EMAIL=you@example.com

# ── 本地/内网验证开关（生产留空）─────────────────────────────────────
# 设为 local_certs 时，Caddy 改用内网 CA 签发证书。
# 为什么需要：用 .test 之类假域名时 ACME 会失败（Let's Encrypt 报
# "contact email has invalid domain"），一个证书都签不出来，HTTPS 全不通。
LIVEFAB_LOCAL_CERTS=

# ── 数据库密码（自己生成一串强随机值）────────────────────────────────
# 生成示例：openssl rand -base64 32
AUTHELIA_DB_PASSWORD=
GHOST_DB_PASSWORD=
GHOST_DB_ROOT_PASSWORD=

# ── 说明：还有几个密钥不需要你填 ─────────────────────────────────────
# Authelia 需要的 jwt / session / storage / reset / smtp 五个密钥，
# 由 compose 里的 authelia-init 服务在首次启动时**自动生成**到数据卷
# （`/data/secrets/`），并且在 .gitignore 覆盖之外。这样避免"把密钥写进 .env 再提交"。

# ── NodeBB（论坛，L6 已定）───────────────────────────────────────────
# NodeBB 用 PostgreSQL（复用同一套 PG 引擎，避免再引入 MongoDB）
NODEBB_DB_PASSWORD=

# ── NodeBB 首次安装（一次性，装完可留空）────────────────────────────
# ⚠️ 前缀必须是 NODEBB_*：NodeBB 的自动化安装只认这个前缀
#    （见镜像内 src/install.js 的 envConfMap）。用 POSTGRES_* 会一直停在 web 安装器。
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_PASSWORD=
NODEBB_ADMIN_EMAIL=admin@example.com
# NodeBB 的会话签名密钥，生成示例：openssl rand -base64 32
NODEBB_SECRET=

# ── 门户的主机名（由 compose 从上面的域名派生，一般不用手改）─────────
# 门户靠这几个值生成各件的链接；改了域名就自动跟着变，代码里不硬编码。
# PORTAL_HOST / AUTH_HOST / GHOST_HOST / FORUM_HOST 由 compose 从
# LIVEFAB_PORTAL_DOMAIN / LIVEFAB_DOMAIN / LIVEFAB_FORUM_DOMAIN 推导。
