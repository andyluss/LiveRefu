{
  "name": "livefab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "LiveFab · 前店后厂的在线工作室底座（M0 骨架）",
  "scripts": {
    "validate": "bun run tools/validate-compose.ts",
    "validate:selftest": "bun run tools/validate-compose.ts --selftest",
    "verify": "bun run tools/verify-stack.ts",
    "verify:selftest": "bun run tools/verify-stack.ts --selftest",
    "backup": "bun run tools/backup.ts",
    "verify:backup": "bun run tools/verify-backup.ts",
    "verify:backup:selftest": "bun run tools/verify-backup.ts --selftest",
    "check:changelog": "node --experimental-strip-types ../../tools/check_changelog.ts --file projects/livefab/CHANGELOG.md --tag-prefix livefab-v",
    "check:changelog:selftest": "node --experimental-strip-types ../../tools/check_changelog.ts --selftest",
    "up": "docker compose -f deploy/compose.yml --env-file .env up -d",
    "down": "docker compose -f deploy/compose.yml --env-file .env down",
    "logs": "docker compose -f deploy/compose.yml --env-file .env logs -f --tail=50",
    "ps": "docker compose -f deploy/compose.yml --env-file .env ps"
  }
}
