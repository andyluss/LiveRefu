# 复制为 .env 并按需填写。四个 Giscus 值留空时，讨论区会降级为"配置说明"页面，
# 站点其余部分完全不受影响。申请步骤见 docs/07_实现记录_M2.md §2.1。

# --- Giscus 讨论区（D4 第一阶段）---
# 公开仓库，形如 owner/repo
NUXT_PUBLIC_GISCUS_REPO=
# 由 giscus.app 生成
NUXT_PUBLIC_GISCUS_REPO_ID=
# Discussion 分类名（建议 Announcements）
NUXT_PUBLIC_GISCUS_CATEGORY=
# 由 giscus.app 生成
NUXT_PUBLIC_GISCUS_CATEGORY_ID=
