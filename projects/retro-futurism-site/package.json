{
  "name": "retro-futurism-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && bun run tools/check-build.ts",
    "start": "bun .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "sync:content": "bun run tools/sync-content.ts",
    "sync:gallery": "bun run tools/sync-gallery.ts",
    "sync:all": "bun run tools/sync-content.ts && bun run tools/sync-gallery.ts",
    "check:content": "bun run tools/sync-content.ts --check && bun run tools/sync-gallery.ts --check",
    "check:build": "bun run tools/check-build.ts",
    "verify:site": "bun run tools/verify-site.ts",
    "verify:search": "bun run tools/verify-search.ts",
    "verify:perf": "bun run tools/verify-perf.ts --selftest",
    "verify:contrast": "bun run tools/verify-contrast.ts",
    "verify:og": "bun run tools/verify-og.ts",
    "verify:giscus": "bun run tools/verify-giscus.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run server/db/migrate.ts",
    "db:backup": "bun run tools/backup-db.ts",
    "db:verify-backup": "bun run tools/verify-backup.ts",
    "verify:deploy": "bun run tools/verify-deploy.ts",
    "verify:storage": "bun run tools/verify-storage.ts",
    "verify:urls": "bun run tools/verify-urls.ts",
    "check": "bun run tools/sync-content.ts --check && bun run tools/sync-gallery.ts --check && bun run tools/check-build.ts",
    "typecheck": "nuxt typecheck",
    "verify": "bun run tools/verify-all.ts",
    "verify:list": "bun run tools/verify-all.ts --list"
  },
  "dependencies": {
    "@nuxt/content": "3.16.1",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/mdc": "0.23.1",
    "drizzle-orm": "0.45.3",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
