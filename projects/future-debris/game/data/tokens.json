{
  "schemaVersion": 1,
  "name": "future-debris.tokens",
  "note": "语法层的**机器可读单一来源**。权威仍是 docs/04_视觉语言与设计token.md；两者的值由 tools/check_tokens.py 强制一致——改一处不同步另一处，闸门会失败。",
  "sourceDoc": "docs/04_视觉语言与设计token.md",
  "colors": {
    "--bg-base": "#10161C",
    "--bg-elev-1": "#18212B",
    "--bg-elev-2": "#212E3A",
    "--surface-sunken": "#0B1116",
    "--material-mid": "#39485A",
    "--material-hi": "#F3EDE1",
    "--material-shadow": "#10161C",
    "--text": "#F3EDE1",
    "--text-dim": "#A9A395",
    "--text-faint": "#9E9889",
    "--line": "#2A3742",
    "--line-strong": "#6F7B89",
    "--power": "#4FD1C5",
    "--residue": "#FF6B35",
    "--accent": "#E4572E",
    "--focus": "#8AB4F8",
    "--warn": "#FFC857",
    "--ok": "#7BD389"
  },
  "typeScale": [
    {
      "token": "title-1",
      "size": 28,
      "lineHeight": 1.25,
      "weight": 700,
      "use": "页面主标题、纪元名"
    },
    {
      "token": "title-2",
      "size": 20,
      "lineHeight": 1.3,
      "weight": 600,
      "use": "面板标题、卡名"
    },
    {
      "token": "body",
      "size": 16,
      "lineHeight": 1.6,
      "weight": 400,
      "use": "正文、卡牌说明"
    },
    {
      "token": "caption",
      "size": 14,
      "lineHeight": 1.5,
      "weight": 500,
      "use": "标签、数值单位、脚注"
    },
    {
      "token": "number-lg",
      "size": 32,
      "lineHeight": 1.0,
      "weight": 700,
      "use": "卡面费用、结算数字（等宽数字）"
    }
  ],
  "fonts": {
    "families": [
      "Menlo",
      "DejaVu Sans Mono",
      "Consolas",
      "monospace"
    ],
    "note": "用 Godot SystemFont 按名查找，不在仓库放字体二进制（沿用既有项目做法）。"
  },
  "spacing": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "unit": 4
  },
  "radius": {
    "control": 4,
    "panel": 8,
    "note": "圆润感来自形状与材质，不来自超大圆角。"
  },
  "stroke": {
    "control": 1.5,
    "focus": 2.0,
    "focusOffset": 1.0
  },
  "shadow": {
    "elevation": "0 2px 8px rgba(0,0,0,.35)",
    "onlyFor": "浮起面（弹窗、拖拽中的卡）"
  },
  "motion": {
    "dur-fast": 120,
    "dur-base": 220,
    "dur-slow": 420,
    "ease-standard": [
      0.2,
      0.0,
      0.2,
      1.0
    ],
    "ease-emphasis": [
      0.2,
      0.0,
      0.0,
      1.0
    ]
  },
  "icon": {
    "canvas": 24,
    "stroke": 1.5,
    "rule": "几何化、单色填充；不得作为可访问性的唯一载体"
  },
  "rootBackground": {
    "token": "--bg-base",
    "themePanelType": "RootBackground",
    "note": "Godot 无全局背景色设置：由根 PanelContainer + RootBackground 面板类型提供。"
  }
}
