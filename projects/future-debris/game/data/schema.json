{
  "schemaVersion": 1,
  "note": "数据表契约（机器可校验）。改动此文件即为改动契约：必须同时更新 docs/04_数据契约.md 与根 CHANGELOG.md。校验器 tools/check_data.py 读取本文件执行校验。",
  "tables": {
    "cards.json": {
      "title": "卡表（时代提案卡）",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^RC-[A-Z]{2,8}-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "faction": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "unit",
            "tower",
            "support",
            "skill",
            "modifier",
            "relic"
          ]
        },
        "rarity": {
          "type": "string",
          "enum": [
            "common",
            "rare",
            "epic"
          ]
        },
        "cost": {
          "type": "int",
          "min": 0,
          "max": 9
        },
        "power": {
          "type": "int",
          "min": 0
        },
        "compute": {
          "type": "int",
          "min": 0,
          "max": 9
        },
        "residue": {
          "type": "int",
          "min": 0
        },
        "keywords": {
          "type": "array",
          "items": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "minEntries": 12,
      "references": [
        {
          "field": "faction",
          "table": "factions.json",
          "label": "卡牌阵营必须存在于势力表"
        }
      ]
    },
    "factions.json": {
      "title": "势力表",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^FAC-[A-Z]{2,8}-[A-Z]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "doctrine": {
          "type": "string",
          "minLength": 1
        },
        "mechanic": {
          "type": "string",
          "minLength": 1
        },
        "residuePosture": {
          "type": "string",
          "enum": [
            "avoids",
            "cleans",
            "moves",
            "feeds"
          ]
        },
        "winCondition": {
          "type": "string",
          "enum": [
            "clear",
            "survive"
          ],
          "note": "胜利条件：clear=清完所有波次；survive=守住所有波次（不必清空配额）。把机制差异变成玩法差异，而不是同一把尺子下的强弱排序。"
        }
      },
      "minEntries": 4
    },
    "levels.json": {
      "title": "关卡表（防线单元）",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^LV-ATOMIC-[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "int",
          "min": 1,
          "max": 12
        },
        "board": {
          "type": "string",
          "minLength": 1
        },
        "waves": {
          "type": "int",
          "min": 1
        },
        "budget": {
          "type": "int",
          "min": 1
        },
        "quotas": {
          "type": "array",
          "items": "int"
        },
        "rule_set": {
          "type": "array",
          "items": "string"
        },
        "quotas_by_faction": {
          "type": "object",
          "note": "按势力的逐波配额：{势力 id: [配额...]}。给了就必须给满 waves 条，否则该势力会静默用到通用曲线（那种不一致不会报错）。",
          "items": "int"
        }
      },
      "minEntries": 8,
      "references": [
        {
          "field": "rule_set",
          "table": "rules.json",
          "label": "关卡引用的规则卡必须存在（数组字段）"
        },
        {
          "field": "quotas_by_faction",
          "table": "factions.json",
          "label": "按势力配额的键必须是存在的势力（对象字段的键）",
          "keyOf": true
        }
      ]
    },
    "modes.json": {
      "title": "模式表（≥3 个模式是纪元契约的一部分）",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^MODE-ATOMIC-[A-Z]{3,6}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "campaign",
            "endless",
            "daily",
            "challenge"
          ]
        },
        "unlock": {
          "type": "string",
          "minLength": 1
        }
      },
      "minEntries": 3
    },
    "relics.json": {
      "title": "未来残片表（跨纪元连接物）",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^FR-[A-Z]{2,8}-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "carryResidue": {
          "type": "int",
          "min": 0
        }
      },
      "minEntries": 3
    },
    "rules.json": {
      "title": "规则卡表（纪元差异的载体）",
      "era": "atomic",
      "entryFields": {
        "id": {
          "type": "string",
          "pattern": "^RULE-[A-Z]{2,8}-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "run_start",
            "turn_start",
            "before_placement",
            "before_combat",
            "wave_cleared"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "condition_value": {
          "type": "int",
          "min": 0
        },
        "effect": {
          "type": "string",
          "enum": [
            "gain_power",
            "reduce_residue",
            "reduce_cost",
            "add_damage",
            "sub_damage",
            "clean_on_turn"
          ]
        },
        "amount": {
          "type": "int",
          "min": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "acquisition": {
          "type": "string",
          "enum": [
            "era_default",
            "level_grant",
            "unlock"
          ]
        }
      },
      "minEntries": 4,
      "note": "规则卡表。acquisition 决定**怎么拿到它**：era_default＝本纪元默认启用；level_grant＝关卡表授予（写在该关 rule_set 里）；unlock＝需在局内解锁（由关卡/事件解锁后累加生效，不删除）。"
    }
  }
}
