{
  "schemaVersion": 1,
  "name": "lrds.app.tokens",
  "platform": "ios-android",
  "unit": "logical-px",
  "note": "由 design/tokens 生成。1 logical px 在基线上映射为 iOS pt / Android dp；文字必须随系统 Dynamic Type / fontScale 缩放，不得用固定高度裁切。颜色只引用 sys.* 语义；产品风格卡另行叠加。",
  "colors": {
    "action.onPrimary": "#0B0F14",
    "action.primary": "#4FD1C5",
    "action.primaryHover": "#57D8C8",
    "bg.base": "#0B0F14",
    "bg.raised": "#161D26",
    "bg.sunken": "#0B1116",
    "bg.surface": "#111823",
    "feedback.danger": "#FF6B35",
    "feedback.success": "#7BD389",
    "feedback.warning": "#FFC857",
    "focus.ring": "#8AB4F8",
    "line.strong": "#66727F",
    "line.subtle": "#24303F",
    "material.highlight": "#F3EDE1",
    "material.mid": "#39485A",
    "material.shadow": "#10161C",
    "text.inverse": "#0B0F14",
    "text.muted": "#808D9F",
    "text.primary": "#F3EDE1",
    "text.secondary": "#9AA7B8"
  },
  "type": [
    {
      "token": "title-1",
      "size": 28,
      "lineHeight": 1.25,
      "weight": 700,
      "use": "页面主标题、纪元名"
    },
    {
      "token": "title-2",
      "size": 20,
      "lineHeight": 1.3,
      "weight": 600,
      "use": "面板标题、卡名"
    },
    {
      "token": "body",
      "size": 16,
      "lineHeight": 1.6,
      "weight": 400,
      "use": "正文、卡牌说明"
    },
    {
      "token": "caption",
      "size": 14,
      "lineHeight": 1.5,
      "weight": 500,
      "use": "标签、数值单位、脚注"
    },
    {
      "token": "number-lg",
      "size": 32,
      "lineHeight": 1,
      "weight": 700,
      "use": "卡面费用、结算数字（等宽数字）"
    }
  ],
  "size": {
    "control": {
      "sm": 32,
      "md": 40,
      "lg": 48
    },
    "touch": {
      "min": 44
    },
    "icon": {
      "sm": 16,
      "md": 24,
      "lg": 32
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radius": {
    "control": 4,
    "panel": 8
  },
  "border": {
    "control": 1.5,
    "focus": 2,
    "focusOffset": 1
  },
  "motion": {
    "fast": 120,
    "base": 220,
    "slow": 420,
    "standard": [
      0.2,
      0,
      0.2,
      1
    ],
    "emphasis": [
      0.2,
      0,
      0,
      1
    ]
  },
  "shadow": {
    "elevated": "0 2px 8px rgba(0,0,0,.35)"
  },
  "accessibility": {
    "minTouchTarget": 44,
    "minContrastText": 4.5,
    "minContrastUi": 3,
    "minTextScale": 2
  }
}
