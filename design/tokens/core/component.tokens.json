{
  "$schema": "../schema/tokens.schema.json",
  "meta": {
    "name": "LRDS Component",
    "version": "0.1.0",
    "note": "组件层：只引用 ref/sys，不定义新的原始值；作为可选层，先服务 button/input/card。"
  },
  "component": {
    "button": {
      "height": { "$value": "{sys.size.control.md}", "$type": "dimension" },
      "paddingX": { "$value": "{sys.space.12}", "$type": "dimension" },
      "radius": { "$value": "{sys.radius.control}", "$type": "dimension" },
      "bg": { "$value": "{sys.color.action.primary}", "$type": "color" },
      "fg": { "$value": "{sys.color.action.onPrimary}", "$type": "color" },
      "border": { "$value": "{sys.color.line.subtle}", "$type": "color" },
      "focus": { "$value": "{sys.color.focus.ring}", "$type": "color" }
    },
    "input": {
      "height": { "$value": "{sys.size.control.md}", "$type": "dimension" },
      "paddingX": { "$value": "{sys.space.12}", "$type": "dimension" },
      "radius": { "$value": "{sys.radius.control}", "$type": "dimension" },
      "bg": { "$value": "{sys.color.bg.surface}", "$type": "color" },
      "fg": { "$value": "{sys.color.text.primary}", "$type": "color" },
      "border": { "$value": "{sys.color.line.subtle}", "$type": "color" },
      "focus": { "$value": "{sys.color.focus.ring}", "$type": "color" }
    },
    "card": {
      "padding": { "$value": "{sys.space.16}", "$type": "dimension" },
      "radius": { "$value": "{sys.radius.panel}", "$type": "dimension" },
      "bg": { "$value": "{sys.color.bg.surface}", "$type": "color" },
      "border": { "$value": "{sys.color.line.subtle}", "$type": "color" }
    }
  }
}
