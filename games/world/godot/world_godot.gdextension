[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
macos.debug = "res://bin/libworld_godot.dylib"
macos.release = "res://bin/libworld_godot.dylib"
linux.debug = "res://bin/libworld_godot.so"
linux.release = "res://bin/libworld_godot.so"
windows.debug = "res://bin/world_godot.dll"
windows.release = "res://bin/world_godot.dll"
