{
  "id": "rule.gate",
  "on": "interact",
  "target": "demo.gate",
  "when": [
    {
      "kind": "has_item",
      "item": "item.token"
    }
  ],
  "then": [
    {
      "kind": "open_door"
    },
    {
      "kind": "set_flag",
      "flag": "flag.gate.open",
      "value": true
    },
    {
      "kind": "emit",
      "event": "gate.opened"
    }
  ],
  "else": [
    {
      "kind": "toast",
      "text": "loc:gate.locked"
    }
  ]
}
