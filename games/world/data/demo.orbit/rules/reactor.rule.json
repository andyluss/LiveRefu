{
  "id": "rule.reactor",
  "on": "interact",
  "target": "demo.reactor",
  "when": [
    {
      "kind": "has_item",
      "item": "item.badge"
    }
  ],
  "then": [
    {
      "kind": "open_door"
    },
    {
      "kind": "set_flag",
      "flag": "flag.reactor.open",
      "value": true
    },
    {
      "kind": "emit",
      "event": "reactor.opened"
    }
  ],
  "else": [
    {
      "kind": "toast",
      "text": "loc:reactor.locked"
    }
  ]
}
