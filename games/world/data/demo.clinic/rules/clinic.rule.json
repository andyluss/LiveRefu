{
  "id": "rule.clinic",
  "on": "interact",
  "target": "demo.clinic.door",
  "when": [
    {
      "kind": "has_item",
      "item": "item.clinic.key"
    }
  ],
  "then": [
    {
      "kind": "open_door"
    },
    {
      "kind": "set_flag",
      "flag": "flag.clinic.open",
      "value": true
    },
    {
      "kind": "emit",
      "event": "clinic.opened"
    }
  ],
  "else": [
    {
      "kind": "toast",
      "text": "loc:clinic.locked"
    }
  ]
}
