; Engine configuration file.
; LiveBay（逍遥湾）· Godot 4.7 垂直切片
; 形态：2D 塔防 / 数据驱动 / 可无头测试
; 本工程的职业、塔、敌人、波次均为【工程占位】，设定以 docs-ai/design01/ 为准。

config_version=5

[application]

config/name="LiveBay"
config/description="逍遥湾 · 月牙城岗位防线（垂直切片）"
config/version="0.1.0"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SaveStore="*res://scripts/autoload/save_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.91, 0.89, 0.84, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/livebay_tools/plugin.cfg")
